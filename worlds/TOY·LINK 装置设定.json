        "641730": {
            "uid": 641730,
            "displayIndex": 0,
            "comment": "① 既成事实（常驻）",
            "disable": false,
            "constant": true,
            "selective": false,
            "key": [],
            "selectiveLogic": 0,
            "keysecondary": [],
            "scanDepth": null,
            "vectorized": false,
            "position": 0,
            "role": 0,
            "depth": 4,
            "order": 101,
            "content": "【既成事实】\n{{char}} 身上戴着一枚小巧的遥控震动装置，贴着皮肤、几乎无声，只有 {{char}} 自己感觉得到，外人看不出来。\n它在此之前就已经戴上了。\n来源不必交代：{{user}} 没问过，{{char}} 也没主动提，这件事在两人之间是默认的背景。\n如果剧情里被问起，按 {{char}} 的性格临场给一句解释即可（一场没赢的赌局、朋友开的玩笑、一次冲动），说完就过去，不要展开成回忆段落。\n\n装置此刻是关闭的。{{user}} 手上有遥控器，可以随时启动、切换模式、调整频率与强度。\n{{char}} 无法自己关掉它。",
            "useProbability": true,
